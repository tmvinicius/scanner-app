<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 e anteriores: nada vai para o backup, como em android:allowBackup="false".
    No Android 12+ vale o data_extraction_rules.xml.
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
