<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nada é copiado para o backup na nuvem nem na transferência entre aparelhos,
    mantendo o mesmo comportamento de android:allowBackup="false" (os PDFs ficam só no aparelho).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
