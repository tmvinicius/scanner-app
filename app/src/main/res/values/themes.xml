<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base da janela; as cores reais vêm do ScannerTheme (Compose). -->
    <style name="Theme.Scanner" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Tema exibido enquanto o app abre (SplashScreen API). -->
    <style name="Theme.Scanner.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_petrol</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Scanner</item>
    </style>
</resources>
